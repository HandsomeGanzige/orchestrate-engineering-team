{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HandsomeGanzige/orchestrate-engineering-team/config.schema.json",
  "title": "Orchestrate Engineering Team configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion"
  ],
  "properties": {
    "apiVersion": {
      "const": "orchestrate-engineering-team/v1"
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/role"
      },
      "propertyNames": {
        "enum": [
          "architecture",
          "development",
          "product-test",
          "review"
        ]
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "project",
            "user"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/skill"
              }
            },
            "materials": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/material"
              }
            }
          }
        },
        "hostBindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferred": {
              "type": "string"
            },
            "adapters": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
