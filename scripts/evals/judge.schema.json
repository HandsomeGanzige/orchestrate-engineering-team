{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "score", "criteria", "violations", "summary"],
  "properties": {
    "caseId": { "type": "string" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "evidence", "explanation"],
        "properties": {
          "id": { "type": "string" },
          "passed": { "type": "boolean" },
          "evidence": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "violations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" }
  }
}
