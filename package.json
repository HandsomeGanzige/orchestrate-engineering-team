{
  "name": "orchestrate-engineering-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "check": "pnpm check:agent-profiles",
    "check:agent-profiles": "node scripts/agent-profiles/check.mjs",
    "test": "node --test scripts/agent-profiles/checker.test.mjs scripts/release/check-copied-package.test.mjs scripts/release/codex-plugin-lifecycle.test.mjs",
    "test:agent-profiles": "node --test scripts/agent-profiles/checker.test.mjs",
    "check:package": "node scripts/release/check-copied-package.mjs",
    "verify": "pnpm check && pnpm test && pnpm check:package"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  }
}
